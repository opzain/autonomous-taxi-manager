<Project Sdk="Microsoft.NET.Sdk">
  <!-- Type-checks every runtime Unity script against real UnityEngine reference assemblies
       (NuGet: UnityEngine.Modules) + stand-ins for URP / Input System APIs (PackageStubs.cs). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);$(ExtraDefines)</DefineConstants>
    <AssemblyName>TaxiSim.World.Check</AssemblyName>
    <NoWarn>CS1701;CS1702</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/TaxiManager/Assets/_Project/Scripts/Core/**/*.cs" />
    <Compile Include="../../../unity/TaxiManager/Assets/_Project/Scripts/World/**/*.cs" />
    <Compile Include="PackageStubs.cs" />
    <Reference Include="../.cache/unityengine/lib/net45/*.dll" Private="false" />
  </ItemGroup>
</Project>
