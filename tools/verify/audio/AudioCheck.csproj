<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders every procedural city sound outside Unity (with a tiny Mathf stand-in) and fails on
       NaN, silence or clipping. WAVs go to tools/verify/.cache/audio so they can be listened to. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>disable</Nullable><LangVersion>12</LangVersion><NoWarn>CS0649;CS0414</NoWarn></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/TaxiManager/Assets/_Project/Scripts/World/Audio/ProceduralAudio.cs" />
    <Compile Include="../../../unity/TaxiManager/Assets/_Project/Scripts/Core/Util/Pcg32.cs" />
  </ItemGroup>
</Project>
